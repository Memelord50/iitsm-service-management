DB_URL="jdbc:mysql://127.0.0.1:3306/iitsm?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true"
DB_USER=iitsm
DB_PASSWORD=replace-with-your-database-password
# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-base64-random-secret
APP_PORT=8080
FRONTEND_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=
SEED_DEMO=true
# All five demo accounts share this development-only password; choose >=12 characters.
DEMO_PASSWORD=replace-with-a-unique-demo-password
AI_API_KEY=
AI_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4.1-mini
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_TLS=false
MAIL_FROM=noreply@iitsm.local
FILE_STORAGE=./var/attachments
SLA_WARNING_THRESHOLDS=50,80
SKILL_THRESHOLD=60
REOPEN_DAYS=90
